# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Cryptographic secret used to sign HttpOnly auth session cookies & payment webhook tokens.
SESSION_SECRET="change_this_to_a_long_random_secret_in_production"

# STRIPE_SECRET_KEY: Optional server-side Stripe secret key (sk_test_... or sk_live_...) for GYMBUD+ subscriptions.
# When omitted, GYMBUD runs in Tokenized Sandbox Checkout mode without storing raw card data.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret (whsec_...) for verifying payment webhooks.
STRIPE_WEBHOOK_SECRET=""

# STRIPE_PRICE_MONTHLY / STRIPE_PRICE_ANNUAL: Optional Stripe Price IDs for AED 49/mo and AED 390/yr plans.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# ADMIN_OWNER_EMAIL: Email address automatically provisioned & promoted as Owner Admin.
ADMIN_OWNER_EMAIL="yusufaguilar2008@gmail.com"

# RESEND_API_KEY: Optional Resend API key for transactional password reset emails.
RESEND_API_KEY=""

# EMAIL_FROM: Sender address for password reset emails (when RESEND_API_KEY or EMAIL_WEBHOOK_URL is set).
EMAIL_FROM="GYMBUD Security <onboarding@resend.dev>"

# EMAIL_WEBHOOK_URL: Optional webhook endpoint for custom SMTP/email relay.
EMAIL_WEBHOOK_URL=""

# VITE_API_BASE_URL: Optional backend origin if hosting the frontend separately from the Express API server.
VITE_API_BASE_URL=""

# DATA_DIR: Optional writable directory path for SQLite database and uploaded photos.
DATA_DIR=""

# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY / SUPABASE_JWKS_URL:
# Server-side Supabase Auth, Storage, and JWKS verification configuration.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

